# Copy to .env to override the defaults used by docker-compose.yml.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

APP_DB=phonebook
APP_DB_USER=phonebook
APP_DB_PASSWORD=phonebook

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Secret used by NextAuth to encrypt the session cookie (e.g. `openssl rand -base64 32`)
NEXTAUTH_SECRET=please-change-me-in-env-file-0123456789
