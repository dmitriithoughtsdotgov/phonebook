# Copy to .env.local for `npm run dev` (Postgres, Keycloak and backend running via docker compose).
NEXTAUTH_URL=http://localhost:3000
# Any long random string, e.g. `openssl rand -base64 32`
NEXTAUTH_SECRET=change-me

KEYCLOAK_CLIENT_ID=phonebook-frontend
KEYCLOAK_CLIENT_SECRET=phonebook-frontend-secret
# Public issuer (browser) and the issuer reachable from the Next.js server.
KEYCLOAK_ISSUER=http://localhost:8080/realms/phonebook
KEYCLOAK_INTERNAL_ISSUER=http://localhost:8080/realms/phonebook

BACKEND_URL=http://localhost:8081
